{
  "name": "voice-agent-test-server",
  "version": "1.0.0",
  "description": "Local test backend for ElevenLabs PI intake voice agent",
  "type": "module",
  "scripts": {
    "start": "node --experimental-sqlite src/index.js",
    "dev": "node --experimental-sqlite --watch src/index.js",
    "setup": "node scripts/setupAgent.js",
    "call": "node scripts/vapiCall.js",
    "sync:assistant": "node scripts/syncAssistant.js",
    "migrate": "node scripts/migrate.js",
    "db:smoke": "node scripts/dbSmoke.js",
    "test": "for f in test/*.test.js; do echo \"› $f\"; node --experimental-sqlite --test \"$f\" || exit 1; done"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.0.0",
    "pg": "^8.21.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
