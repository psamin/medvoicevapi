# ─────────────────────────────────────────────────────────────
# SERVER ENVIRONMENT — copy to .env and fill in. NEVER commit .env.
# All keys here are SERVER-ONLY. Do not expose them to the frontend.
# ─────────────────────────────────────────────────────────────

# --- Runtime ---
PORT=3001
NODE_ENV=development

# --- Vapi (https://dashboard.vapi.ai) ---
# Private API key — server-only. Used to create/trigger calls via Vapi's REST API
# and to verify incoming webhooks. NEVER expose to the browser.
VAPI_API_KEY=
# The assistant you create in the Vapi dashboard (Assistants tab).
VAPI_ASSISTANT_ID=
# A phone number provisioned in Vapi (Phone Numbers tab). Needed for outbound test calls.
VAPI_PHONE_NUMBER_ID=
# Public key — safe to expose to the browser for Web SDK calls. Mirror into the
# frontend as NEXT_PUBLIC_VAPI_PUBLIC_KEY.
VAPI_PUBLIC_KEY=

# --- ElevenLabs (https://elevenlabs.io) ---
# Used as the VOICE PROVIDER inside Vapi. Our server does NOT need this for Vapi
# calls (Vapi holds its own ElevenLabs credential), but it is kept here for the
# legacy ElevenLabs web-SDK flow and any direct API use. SERVER-ONLY.
ELEVENLABS_API_KEY=
# The voice you want Vapi (or the legacy flow) to speak with.
ELEVENLABS_VOICE_ID=

# --- Mock CRM / database ---
# Where the JSON-backed mock DB is persisted. Safe to delete to reset.
MOCK_DB_PATH=./data/mock-db.json

# --- Webhooks ---
# Public HTTPS base URL Vapi can reach (e.g. your ngrok tunnel to PORT).
# Vapi tool calls and end-of-call reports POST here. Example:
#   WEBHOOK_BASE_URL=https://abc123.ngrok-free.app
WEBHOOK_BASE_URL=

# ─────────────────────────────────────────────────────────────
# LEGACY — only needed for the original ElevenLabs Conversational AI web flow
# (GET /api/get-signed-url). Safe to leave blank if you only use Vapi.
# ─────────────────────────────────────────────────────────────
ELEVENLABS_AGENT_ID=
NGROK_URL=
