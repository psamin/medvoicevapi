# ─────────────────────────────────────────────────────────────
# SERVER ENVIRONMENT — copy to .env and fill in. NEVER commit .env.
# All keys here are SERVER-ONLY. Do not expose them to the frontend.
#
# Vapi manages voice (built-in voice "Elliot"), transcription (Deepgram), and the
# model (OpenAI) for you. So this backend only needs Vapi credentials + a local
# database. You do NOT need ElevenLabs, Deepgram, or OpenAI keys here — those all
# live inside the Vapi assistant config.
# ─────────────────────────────────────────────────────────────

# --- Runtime (have sensible defaults) ---
PORT=3001
NODE_ENV=development

# ============ REQUIRED ============
# --- Vapi (https://dashboard.vapi.ai) ---
# Private API key — creates/triggers calls via Vapi's REST API. NEVER expose.
VAPI_API_KEY=
# The assistant you configured in the Vapi dashboard (Assistants tab).
VAPI_ASSISTANT_ID=
# A phone number provisioned in Vapi (Phone Numbers tab). Needed for phone calls.
VAPI_PHONE_NUMBER_ID=
# Shared secret to verify incoming Vapi tool/webhook requests. Set the SAME value
# in the Vapi dashboard (server secret / custom header). If blank, verification is
# skipped — fine for local dev; set it before exposing the server publicly.
# (VAPI_SERVER_URL_SECRET is accepted as an alias.)
VAPI_WEBHOOK_SECRET=
VAPI_SERVER_URL_SECRET=
# Postgres connection string. When set, the MVP stores clients/cases/intake
# fields/calls/email logs in Postgres (run `npm run migrate` first). When blank,
# the JSON store at MOCK_DB_PATH is used (zero setup). Example:
#   DATABASE_URL=postgres://user:pass@localhost:5432/medvoice
# Set PGSSL=disable for a local server that doesn't use SSL.
DATABASE_URL=

# ============ MedVoice MVP ============
# Public base URL of THIS app, used to build the client intake form link emailed
# after a call (e.g. http://localhost:3000 locally, or your deployed/ngrok URL).
APP_BASE_URL=http://localhost:3000
# Email: "sendgrid" uses SendGrid when SENDGRID_API_KEY is set; otherwise dry-run.
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=
FROM_EMAIL=intake@example.com
# Dry-run safety: when true (or keys missing), emails and Vapi calls are LOGGED,
# not actually sent/placed. Flip to false once keys are configured.
DRY_RUN_EMAILS=true
DRY_RUN_VAPI_CALLS=true

# ============ OPTIONAL ============
# Public key — browser-safe; only needed for the web-call test page (/vapi).
# Mirror into the frontend as NEXT_PUBLIC_VAPI_PUBLIC_KEY if you prefer.
VAPI_PUBLIC_KEY=
# Where the JSON-backed local dev DB is persisted. Safe to delete to reset.
MOCK_DB_PATH=./data/mock-db.json
# Public HTTPS base URL Vapi can reach (your ngrok tunnel to PORT). Used to build
# the tool Server URLs you paste into Vapi. Example: https://abc123.ngrok-free.app
WEBHOOK_BASE_URL=

# --- Real CRM integration (future; mocked locally for now) ---
# CRM_PROVIDER selects the adapter: "mock" (default) uses the local JSON store.
# Set provider + key + base URL later to talk to a real CRM (salesforce/hubspot/...).
CRM_PROVIDER=mock
CRM_API_KEY=
CRM_BASE_URL=

# ============ LEGACY / NOT REQUIRED ============
# These are ONLY for the old ElevenLabs Conversational AI web flow that predates
# Vapi (GET /api/get-signed-url, the "/" test page). Vapi does NOT need them.
# Leave them blank/commented unless you intentionally use the legacy EL flow or
# switch the Vapi assistant's voice provider to a custom ElevenLabs voice.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_AGENT_ID=
# NGROK_URL=
# DEEPGRAM_API_KEY=   # only if you ever transcribe OUTSIDE Vapi
