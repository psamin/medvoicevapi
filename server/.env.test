# ─────────────────────────────────────────────────────────────
# LOCAL E2E TEST ENV — safe values only. No real Vapi / SendGrid / Twilio.
# Loaded via:  node --experimental-sqlite --env-file=.env.test src/index.js
# These take precedence over .env (dotenv does not override already-set vars),
# so your real keys in .env never load during a test run.
# ─────────────────────────────────────────────────────────────

PORT=3001
NODE_ENV=test

# --- Isolated test storage (does NOT touch data/medvoice.db) ---
SQLITE_PATH=./data/medvoice-test.db
MOCK_DB_PATH=./data/mock-db-test.json
DATABASE_URL=
# STORAGE= (blank = SQLite, the default source of truth)

# --- Dry-run safety: emails + Vapi calls are LOGGED, never sent/placed ---
DRY_RUN_EMAILS=true
DRY_RUN_VAPI_CALLS=true

# --- Fake Vapi creds (defined here so real .env keys are NOT pulled in) ---
VAPI_API_KEY=test_vapi_key
VAPI_ASSISTANT_ID=test_assistant_id
VAPI_PHONE_NUMBER_ID=test_phone_number_id
# Leave webhook secret blank → verification skipped locally (dev convenience).
VAPI_WEBHOOK_SECRET=
VAPI_SERVER_URL_SECRET=

# --- Email (mock / dry-run) ---
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=
FROM_EMAIL=no-reply@test-medvoice.local

# --- Intake form link base (frontend dev server) ---
APP_BASE_URL=http://localhost:3000

# --- CRM opt-out store (mock) ---
CRM_PROVIDER=mock
