# ─────────────────────────────────────────────────────────────
# FRONTEND ENVIRONMENT (Next.js) — copy to .env.local and fill in.
#
# NOTE: This is a Next.js app, so browser-exposed vars MUST be prefixed with
# NEXT_PUBLIC_ (the spec's VITE_* names do not apply here). Anything with the
# NEXT_PUBLIC_ prefix is shipped to the browser — only put PUBLIC values here.
# NEVER put VAPI_API_KEY or ELEVENLABS_API_KEY in this file.
# ─────────────────────────────────────────────────────────────

# Local server base URL (equivalent of the spec's VITE_SERVER_URL).
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Vapi public key — safe to expose. Used by the Web SDK to start browser calls.
NEXT_PUBLIC_VAPI_PUBLIC_KEY=

# The Vapi assistant to dial in web calls.
NEXT_PUBLIC_VAPI_ASSISTANT_ID=
